    "Shut Up" : {
      "comment" : "The name of the app.",
      "isCommentAutoGenerated" : true,
      "shouldTranslate" : false
    },
    "Shut Up asked Safari if its extensions are enabled, but it failed. Try quitting Shut Up and moving it to your Applications folder.\n\nIf the issue persists, try uninstalling Shut Up, restarting your Mac, and reinstalling Shut Up." : {
      "comment" : "BrowserError.requestingExtensionStatus – info",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shut Up hat Safari gefragt, ob seine Erweiterungen aktiviert sind, aber dies ist fehlgeschlagen. Versuchen Sie, Shut Up zu beenden und in Ihren Anwendungsordner zu verschieben.\n\nWenn das Problem weiterhin besteht, versuchen Sie, Shut Up zu deinstallieren, Ihren Mac neu zu starten und Shut Up erneut zu installieren."
          }
        }
      }
    },
    "Shut Up asked Safari to open its settings window, but it failed. Try opening Safari’s settings manually, then go to the “Extensions” section." : {
      "comment" : "BrowserError.showingSafariPreferences – info",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shut Up forderte Safari auf, sein Einstellungsfenster zu öffnen, dies schlug jedoch fehl. Versuchen Sie, die Safari-Einstellungen manuell zu öffnen, und gehen Sie dann zum Abschnitt „Erweiterungen“."
          }
        }
      }
    },
    "Shut Up failed to decrypt some required data. You can fix this by resetting Shut Up, but your allowlist may be lost." : {
      "comment" : "CryptoError.fetchingKeys – info\nCryptoError.transformingData – info",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shut Up konnte einige erforderliche Daten nicht entschlüsseln. Sie können dies beheben, indem Sie Shut Up zurücksetzen. Ihre Erlaubnisliste geht dabei jedoch möglicherweise verloren."
          }
        }
      }
    },
    "Shut Up failed to read from an internal file. If this issue persists, please quit and restart Shut Up." : {
      "comment" : "FileError.readingFile – info",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shut Up konnte eine interne Datei nicht lesen. Wenn das Problem weiterhin besteht, beenden Sie Shut Up und starten Sie es erneut."
          }
        }
      }
    },
    "Shut Up failed to write to an internal file. If this issue persists, please quit and restart Shut Up." : {
      "comment" : "FileError.writingFile – info",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shut Up konnte nicht in eine interne Datei schreiben. Wenn das Problem weiterhin besteht, beenden Sie Shut Up und starten Sie es erneut."
          }
        }
      }
    },
    "Shut Up Homepage" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shut Up-Website"
          }
        }
      }
    },
    "Shut Up sent Safari new content-blocking rules, but it failed. Try restarting Safari. If the issue persists, restart your iPhone or iPad." : {
      "comment" : "BrowserError.providingBlockRules – info",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shut Up hat Safari neue Regeln zur Inhaltsblockierung gesendet, aber es ist fehlgeschlagen. Versuchen Sie, Safari neu zu starten. Wenn das Problem weiterhin besteht, starten Sie Ihr iPhone oder iPad neu."
          }
        }
      }
    },
    "Shut Up sent Safari new content-blocking rules, but it failed. Try restarting Safari. If the issue persists, try restarting your Mac." : {
      "comment" : "BrowserError.providingBlockRules – info",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shut Up hat Safari neue Regeln zur Inhaltsblockierung gesendet, aber es ist fehlgeschlagen. Versuchen Sie, Safari neu zu starten. Wenn das Problem weiterhin besteht, versuchen Sie, Ihren Mac neu zu starten."
          }
        }
      }
    },
    "Shut Up tried to update the stylesheet, but the response the server sent was invalid. Try again later." : {
